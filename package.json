{
  "name": "crie",
  "version": "0.1.0",
  "description": "Generate React intrinsic element typings from an Angular Elements library",
  "type": "module",
  "bin": { "crie": "./dist/cli.mjs" },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts",
    "dev": "tsup src/cli.ts --format esm --dts --watch",
    "react-types": "node dist/cli.mjs react-types"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "colorette": "^2.0.20",
    "cosmiconfig": "^9.0.0",
    "glob": "^11.0.0",
    "ts-morph": "^22.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4"
  },
  "engines": { "node": ">=18.18" },
  "license": "MIT"
}
